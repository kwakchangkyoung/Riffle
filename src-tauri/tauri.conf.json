{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Riffle",
    "version": "0.4.0",
    "identifier": "com.gajago.riffle",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Riffle",
                "width": 1200,
                "height": 800,
                "dragDropEnabled": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyMjVDNTYxOTk1RjM3REMKUldUY04xK1pZY1VsRW9xRWs5T1pLb3daalZRN2VrbzRPRjlUOWl3eVd1SDNWNHNMUWVTcjJhQ24K",
            "endpoints": [
                "https://github.com/kwakchangkyoung/Riffle/releases/latest/download/latest.json"
            ]
        }
    },
    "bundle": {
        "active": true,
        "targets": ["app", "dmg"],
        "category": "DeveloperTool",
        "shortDescription": "대용량 텍스트 로그 뷰어",
        "longDescription": "수 GB~수십 GB 텍스트 로그를 즉시 열고 부드럽게 스크롤하며 빠르게 검색하는 macOS용 로그 뷰어입니다.",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.png"
        ],
        "macOS": {
            "minimumSystemVersion": "11.0"
        },
        "resources": ["agents/"],
        "fileAssociations": [
            {
                "ext": ["log", "txt"],
                "name": "Text Log",
                "description": "텍스트 로그 파일",
                "mimeType": "text/plain",
                "role": "Viewer"
            },
            {
                "ext": ["gz"],
                "name": "Gzip Log",
                "description": "gzip 압축 로그 파일",
                "mimeType": "application/gzip",
                "role": "Viewer"
            }
        ]
    }
}
